DATABASE_URL="postgresql://pmtool:pmtool_dev@localhost:5432/pmtool_dev"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_REFRESH_TTL_DAYS="30"

CORS_ORIGIN="http://localhost:3000"
PORT="3001"
NODE_ENV="development"

# Optional — without it, AI endpoints (modules/ai) return a clear error
# instead of working. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional — without a bot token, Telegram notifications silently no-op.
# Get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=""
# Shared secret Telegram sends back on every webhook call — pick any random string.
TELEGRAM_WEBHOOK_SECRET=""
# Must be a publicly reachable HTTPS URL for the Telegram webhook to work
# (e.g. via ngrok in local dev). Defaults to localhost, which Telegram cannot reach.
API_PUBLIC_URL="http://localhost:3001"

# --- Free-tier abuse and cost controls -------------------------------------
# Per-route request limits (login, register, AI, ...). Set to "false" only for
# automated tests that register many users from one IP.
RATE_LIMIT_ENABLED="true"
# Number of reverse proxies in front of the API (so limits key on the real client IP).
TRUST_PROXY="0"
# AI calls each organization may make per Vietnam calendar day.
AI_DAILY_LIMIT_PER_ORG="100"
# Organizations one account may own.
MAX_ORGS_PER_USER="5"

# --- Email (optional) -------------------------------------------------------
# Without SMTP_HOST the API only logs the emails it would send (password reset,
# email verification, invitations). Any SMTP provider works.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="PMTool <no-reply@example.com>"
# Base URL of the web app, used for the links inside emails.
WEB_PUBLIC_URL="http://localhost:3000"
# "true" = accounts must verify their email before using AI or sending invitations.
# Turn on once SMTP is configured.
EMAIL_VERIFICATION_REQUIRED="false"

# --- Sign in with Google (optional) ------------------------------------------
# Create an OAuth client (type "Web application") in Google Cloud Console → APIs & Services →
# Credentials, and add this exact Authorized redirect URI:
#   <API_PUBLIC_URL>/api/v1/auth/google/callback
# With both values empty the "Continue with Google" button is hidden.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
