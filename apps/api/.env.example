DATABASE_URL="postgresql://pmtool:pmtool_dev@localhost:5432/pmtool_dev"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_REFRESH_TTL_DAYS="30"

CORS_ORIGIN="http://localhost:3000"
PORT="3001"
NODE_ENV="development"

# Optional — without it, AI endpoints (modules/ai) return a clear error
# instead of working. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional — without a bot token, Telegram notifications silently no-op.
# Get a token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=""
# Shared secret Telegram sends back on every webhook call — pick any random string.
TELEGRAM_WEBHOOK_SECRET=""
# Must be a publicly reachable HTTPS URL for the Telegram webhook to work
# (e.g. via ngrok in local dev). Defaults to localhost, which Telegram cannot reach.
API_PUBLIC_URL="http://localhost:3001"
