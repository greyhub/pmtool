generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgRole {
  OWNER
  ADMIN
  PM
  MEMBER
  VIEWER
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  fullName       String
  avatarUrl      String?
  locale         String   @default("vi")
  themePref      String   @default("system")
  mascotCharacter String  @default("fox")
  telegramChatId String?  @unique
  // Daily task-status digest via Telegram — distinct from the due-date
  // sweep (Task.telegramReminderSentAt). Enabled by default so anyone who
  // links Telegram gets it unless they opt out; hour is plain VN local
  // time (0-23), no per-user timezone field exists yet.
  dailyDigestEnabled      Boolean   @default(true)
  dailyDigestHour         Int       @default(17)
  dailyDigestLastSentDate DateTime? @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  memberships           Membership[]
  refreshTokens         RefreshToken[]
  projectMembers        ProjectMember[]
  taskAssignments       TaskAssignee[]
  comments              Comment[]
  ownedRiskIssues       RiskIssue[]
  activityLogs          ActivityLog[]
  userScores            UserScore[]
  userBadges            UserBadge[]
  userQuestProgress     UserQuestProgress[]
  ownedDeliverables     Deliverable[]      @relation("DeliverableOwner")
  reviewedDeliverables  Deliverable[]      @relation("DeliverableReviewer")
  telegramLinkCodes     TelegramLinkCode[]
  managedCharters       ProjectCharter[]   @relation("CharterProjectManager")
  approvedCharters      ProjectCharter[]   @relation("CharterApprover")
  approvedScopes        ProjectScope[]     @relation("ScopeApprover")
  stakeholderProfiles   Stakeholder[]
  ownedProjectDocuments ProjectDocument[]

  @@map("users")
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships      Membership[]
  invites          MembershipInvite[]
  projects         Project[]
  projectMembers   ProjectMember[]
  tasks            Task[]
  taskAssignees    TaskAssignee[]
  taskDependencies TaskDependency[]
  boardColumns     BoardColumn[]
  comments         Comment[]
  riskIssues       RiskIssue[]
  activityLogs     ActivityLog[]
  userScores       UserScore[]
  userBadges       UserBadge[]
  userQuestProgress UserQuestProgress[]
  deliverables     Deliverable[]
  projectCharters  ProjectCharter[]
  projectScopes    ProjectScope[]
  wbsDictionary    WbsDictionaryEntry[]
  stakeholders     Stakeholder[]
  projectDocuments ProjectDocument[]
  artifacts        Artifact[]

  @@map("organizations")
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("memberships")
}

model MembershipInvite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           OrgRole
  tokenHash      String    @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("membership_invites")
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

model Project {
  id             String        @id @default(cuid())
  organizationId String
  key            String // short project code, e.g. "PMT" — used in task human keys "PMT-123"
  name           String
  description    String?
  status         ProjectStatus @default(PLANNING)
  startDate      DateTime?
  targetEndDate  DateTime?
  taskSequence   Int           @default(0) // monotonically incremented to mint Task.humanKey
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      ProjectMember[]
  tasks        Task[]
  boardColumns BoardColumn[]
  risks        RiskIssue[]
  charter      ProjectCharter?
  scope        ProjectScope?
  stakeholders Stakeholder[]
  documents    ProjectDocument[]
  artifacts    Artifact[]
  deliverables Deliverable[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("projects")
}

model ProjectMember {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  userId         String
  role           OrgRole
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([organizationId])
  @@map("project_members")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id                     String       @id @default(cuid())
  organizationId         String // denormalized for the tenant-scoping Prisma extension + fast index
  projectId              String
  humanKey               String // e.g. "PMT-123", minted from Project.key + Project.taskSequence
  parentTaskId           String? // self-relation -> WBS hierarchy (subtasks)
  title                  String
  description            Json? // structured rich-text doc, not a plain string — AI features can parse it later without a migration
  status                 TaskStatus   @default(TODO)
  priority               TaskPriority @default(MEDIUM)
  startDate              DateTime?
  dueDate                DateTime?
  estimateHours          Float?
  percentComplete        Int          @default(0) // 0-100, manually set — not derived from status/subtasks
  nodeType               WbsNodeType  @default(ACTIVITY) // PMBOK role in the WBS: phase > deliverable > work package > activity
  isMilestone            Boolean      @default(false) // a zero-duration checkpoint: shows as a diamond on the Gantt and in the Milestones tab
  orderIndex             Float // fractional index for drag-reorder within a WBS level/board column
  boardColumnId          String?
  createdById            String
  telegramReminderSentAt DateTime? // dedup marker for the daily due-date reminder cron; reset to null whenever dueDate changes
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       Task?          @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]         @relation("TaskHierarchy")
  boardColumn  BoardColumn?   @relation(fields: [boardColumnId], references: [id])
  assignees    TaskAssignee[]
  comments     Comment[]
  deliverables Deliverable[]
  dictionary   WbsDictionaryEntry?

  dependenciesAsPredecessor TaskDependency[] @relation("PredecessorTask")
  dependenciesAsSuccessor   TaskDependency[] @relation("SuccessorTask")

  @@unique([projectId, humanKey])
  @@index([organizationId])
  @@index([projectId, status])
  @@index([parentTaskId])
  @@map("tasks")
}

/// PRIMARY = the one accountable person (at most one per task — enforced by a
/// partial unique index in migration 20260920063000, which Prisma's schema
/// language can't express); SUPPORT = anyone helping.
/// PMBOK role of a task in the work breakdown structure. A child's rank must be
/// lower than its parent's (PHASE > DELIVERABLE > WORK_PACKAGE > ACTIVITY).
enum WbsNodeType {
  PHASE
  DELIVERABLE
  WORK_PACKAGE
  ACTIVITY
}

enum TaskAssigneeRole {
  PRIMARY
  SUPPORT
}

model TaskAssignee {
  organizationId String
  taskId         String
  userId         String
  role           TaskAssigneeRole @default(SUPPORT)
  assignedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([organizationId])
  @@map("task_assignees")
}

enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

model TaskDependency {
  id             String         @id @default(cuid())
  organizationId String
  predecessorId  String
  successorId    String
  type           DependencyType @default(FINISH_TO_START)
  lagDays        Int            @default(0)
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  predecessor  Task         @relation("PredecessorTask", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor    Task         @relation("SuccessorTask", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([organizationId])
  @@map("task_dependencies")
}

model BoardColumn {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  orderIndex     Float
  wipLimit       Int?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@index([organizationId])
  @@index([projectId])
  @@map("board_columns")
}

model Comment {
  id             String    @id @default(cuid())
  organizationId String
  taskId         String
  authorId       String
  body           Json // structured rich-text doc, same rationale as Task.description
  createdAt      DateTime  @default(now())
  editedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([taskId])
  @@map("comments")
}

enum RiskIssueType {
  RISK
  ISSUE
}

enum RiskStatus {
  IDENTIFIED
  ANALYZING
  MITIGATING
  RESOLVED
  CLOSED
}

model RiskIssue {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String
  type           RiskIssueType
  title          String
  description    String?
  probability    Int? // 1-5, RISK only
  impact         Int? // 1-5, RISK only
  severityScore  Int? // probability * impact, denormalized for fast sort/filter
  status         RiskStatus    @default(IDENTIFIED)
  ownerId        String?
  dueDate        DateTime?
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User?        @relation(fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([projectId, status])
  @@map("risk_issues")
}

enum CharterStatus {
  DRAFT
  APPROVED
}

/// One per project — formally authorizes it (PMBOK Project Charter). Editing
/// an already-APPROVED charter via upsert reverts status to DRAFT and clears
/// approvedById/approvedAt, forcing re-approval.
model ProjectCharter {
  id                String        @id @default(cuid())
  organizationId    String
  projectId         String        @unique
  purpose           Json? // business case / justification — toRichText(), same shape as Task.description
  objectives        Json? // objectives & success criteria
  scopeSummary      Json? // high-level in/out of scope
  milestonesSummary String? // plain text — no live Milestone entity yet
  budgetSummary     String? // plain text — no Cost/EVM model yet
  assumptions       Json?
  constraints       Json?
  sponsorName       String?
  projectManagerId  String?
  status            CharterStatus @default(DRAFT)
  approvedById      String?
  approvedAt        DateTime?
  createdById       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectManager User?        @relation("CharterProjectManager", fields: [projectManagerId], references: [id])
  approvedBy     User?        @relation("CharterApprover", fields: [approvedById], references: [id])

  @@index([organizationId])
  @@map("project_charters")
}

enum StakeholderCategory {
  INTERNAL
  EXTERNAL
}

enum StakeholderLevel {
  LOW
  MEDIUM
  HIGH
}

enum StakeholderEngagementLevel {
  UNAWARE
  RESISTANT
  NEUTRAL
  SUPPORTIVE
  LEADING
}

/// PMBOK Stakeholder Register. userId is optional — most PMBOK stakeholders
/// (customers, regulators, vendors) are never PMTool users, so fullName/role/
/// organizationName/email/phone are always plain columns.
model Stakeholder {
  id                String                     @id @default(cuid())
  organizationId    String
  projectId         String
  userId            String?
  fullName          String
  role              String?
  organizationName  String?
  email             String?
  phone             String?
  category          StakeholderCategory        @default(INTERNAL)
  influence         StakeholderLevel           @default(MEDIUM)
  interest          StakeholderLevel           @default(MEDIUM)
  currentEngagement StakeholderEngagementLevel @default(NEUTRAL)
  desiredEngagement StakeholderEngagementLevel @default(SUPPORTIVE)
  notes             String?
  createdById       String
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@map("stakeholders")
}

enum DocumentCategory {
  CHARTER
  PLAN
  REPORT
  CONTRACT
  MEETING_NOTES
  DESIGN
  REQUIREMENT
  OTHER
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  OBSOLETE
}

/// PMBOK Document Register — a catalog of project documents (title, category,
/// version, status, external URL). Not a file store: PMTool has no file
/// storage/upload infra yet, so `url` points at wherever the document
/// actually lives (Drive, SharePoint, ...).
model ProjectDocument {
  id             String           @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  category       DocumentCategory @default(OTHER)
  version        String           @default("1.0")
  status         DocumentStatus   @default(DRAFT)
  url            String
  ownerId        String?
  description    String?
  createdById    String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner        User?        @relation(fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@map("project_documents")
}

enum DeliverableStatus {
  PLANNED
  IN_PROGRESS
  SUBMITTED
  ACCEPTED
  REJECTED
}

/// A tangible output of the project, optionally tied to the task (or
/// milestone) that produces it. SUBMITTED -> ACCEPTED/REJECTED is a
/// sign-off by PM+ (like ProjectCharter's approval); editing the content of a
/// reviewed deliverable sends it back to IN_PROGRESS.
model Deliverable {
  id                 String            @id @default(cuid())
  organizationId     String
  projectId          String
  taskId             String?
  name               String
  description        String?
  acceptanceCriteria String?
  status             DeliverableStatus @default(PLANNED)
  ownerId            String?
  dueDate            DateTime?
  url                String?
  submittedAt        DateTime?
  reviewedById       String?
  reviewedAt         DateTime?
  rejectionReason    String?
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  owner        User?        @relation("DeliverableOwner", fields: [ownerId], references: [id])
  reviewedBy   User?        @relation("DeliverableReviewer", fields: [reviewedById], references: [id])

  @@index([organizationId])
  @@index([projectId])
  @@index([taskId])
  @@map("deliverables")
}

/// User-authored HTML/CSS/JS page, rendered client-side in a sandboxed
/// iframe (sandbox="allow-scripts", no allow-same-origin — see
/// apps/web/src/features/artifacts/artifact-editor.tsx for the security
/// rationale). htmlContent capped at 200,000 chars by the Zod schema, not
/// here — Prisma String maps to Postgres text (unbounded) either way.
model Artifact {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  htmlContent    String   @default("")
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@map("artifacts")
}

/// Append-only event stream (actor, entity, action, metadata) written by
/// AuditLogInterceptor after task/project/risk/comment mutations. Phase 1
/// only surfaces it as a dashboard feed; Phase 2 gamification/AI reads it too.
model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String
  entityType     String
  entityId       String
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User         @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("activity_logs")
}

/// Running per-user point total + streak, updated explicitly by
/// GamificationService.awardPoints at specific meaningful transitions
/// (task completed, risk resolved, ...) — not derived from ActivityLog,
/// whose action strings are too generic to express "status became DONE".
model UserScore {
  id                  String    @id @default(cuid())
  organizationId      String
  userId              String
  totalPoints         Int       @default(0)
  currentStreakDays   Int       @default(0)
  longestStreakDays   Int       @default(0)
  lastActivityDate    DateTime?
  // Per-category counters, incremented alongside totalPoints by whichever
  // awardPoints() reason fired — badge checks read these directly instead of
  // deriving "who completed/resolved/commented" from Task/RiskIssue/Comment,
  // which don't track that (Task has no "completedById", etc.).
  tasksCreatedCount   Int       @default(0)
  tasksCompletedCount Int       @default(0)
  risksResolvedCount  Int       @default(0)
  commentsCount       Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("user_scores")
}

model UserBadge {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  badgeKey       String
  earnedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, badgeKey])
  @@map("user_badges")
}

/// Per-period (day/week) progress toward a fixed, code-defined quest — see
/// QUEST_KEYS in shared-types. periodKey is a VN-calendar date key ("YYYY-MM-DD")
/// for daily quests, or that same format for the Monday of the ISO week for
/// weekly quests; a new row per period is the reset mechanism (no cron needed).
model UserQuestProgress {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  questKey       String
  periodKey      String
  progressCount  Int       @default(0)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, questKey, periodKey])
  @@map("user_quest_progress")
}

/// Short-lived, hashed, single-use code linking a Telegram chat to a User —
/// shaped like RefreshToken (hash + compare), not MembershipInvite, since
/// this is user-level, not org-level (no organizationId, correctly excluded
/// from TENANT_SCOPED_MODELS the same way RefreshToken already is).
model TelegramLinkCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("telegram_link_codes")
}

/// PMBOK Project Scope Statement — one per project. Editing an APPROVED scope
/// reverts it to DRAFT (same rule as ProjectCharter).
model ProjectScope {
  id                  String        @id @default(cuid())
  organizationId      String
  projectId           String        @unique
  inScope             Json?
  outOfScope          Json?
  deliverablesSummary Json?
  acceptanceCriteria  Json?
  assumptions         Json?
  constraints         Json?
  status              CharterStatus @default(DRAFT)
  approvedById        String?
  approvedAt          DateTime?
  createdById         String
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy   User?        @relation("ScopeApprover", fields: [approvedById], references: [id])

  @@index([organizationId])
  @@map("project_scopes")
}

/// PMBOK WBS Dictionary entry — the detail behind one WBS element (1:1 with a Task).
model WbsDictionaryEntry {
  id                  String   @id @default(cuid())
  organizationId      String
  taskId              String   @unique
  scopeDescription    Json?
  acceptanceCriteria  Json?
  assumptions         Json?
  constraints         Json?
  requiredResources   String?
  qualityRequirements String?
  technicalReferences String?
  costEstimate        Float?
  updatedById         String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("wbs_dictionary_entries")
}
