# Copy to infra/.env.prod and fill in. NEVER commit the real file.

# Public address. SITE_ADDRESS is what Caddy serves (a real domain gets an automatic HTTPS certificate;
# "localhost" gives a local self-signed one). SITE_URL is the same with the scheme.
SITE_ADDRESS=pm.example.com
SITE_URL=https://pm.example.com

# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Shown in the public Terms of use / Privacy policy.
OPERATOR_NAME=
CONTACT_EMAIL=

# Comma-separated emails allowed to view/triage in-app feedback (the "Góp ý" page). Empty = no one; submitting still works.
FEEDBACK_ADMIN_EMAILS=

# Optional features (leave empty to keep them off) — see apps/api/.env.example
ANTHROPIC_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PMTool <no-reply@pm.example.com>
EMAIL_VERIFICATION_REQUIRED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Cost and abuse limits
AI_DAILY_LIMIT_PER_ORG=100
MAX_ORGS_PER_USER=5

# Backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=20
# BACKUP_DIR=/srv/pmtool-backups   # put backups on a different disk/volume than the database

# Cloudflare Tunnel (home / office server; see docs/trien-khai-mac-mini.md)
CLOUDFLARE_TUNNEL_TOKEN=

# Off-server backup copies with rclone (docker-compose.offsite.yml)
# RCLONE_REMOTE=gdrive:pmtool-backups
# OFFSITE_KEEP_DAYS=60
# RCLONE_CONFIG_DIR=~/.config/pmtool-rclone
