# Caddy terminates HTTPS (certificates are issued and renewed automatically for a real domain)
# and serves web and API from ONE origin, so cookies are first-party and no CORS is involved.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy api:3001
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
