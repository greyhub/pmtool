# Copy to .env and fill in real values for local development.
# apps/api and apps/web each also have their own .env.example with app-scoped subsets.

DATABASE_URL="postgresql://pmtool:pmtool_dev@localhost:5432/pmtool_dev"
REDIS_URL="redis://localhost:6379"

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"

CORS_ORIGIN="http://localhost:3000"

NEXT_PUBLIC_API_URL="http://localhost:3001"
